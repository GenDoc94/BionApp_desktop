# Copia este archivo a ".env" o usa: npm run setup
#
# Modo red (Supabase en la nube):
#   VITE_BIONAPP_MODE=red
#   VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
#   VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
#
# Modo local (generado por npm run setup:local):
#   VITE_BIONAPP_MODE=local
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=...

VITE_BIONAPP_MODE=red
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
